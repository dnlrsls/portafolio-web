const description = descriptions[subject];
const descriptionId = `showcase-ascii-art-${subject}`;
---

<figure class:list={['showcase-ascii-art', `showcase-ascii-art--${subject}`]} role="img" aria-labelledby={descriptionId}>
  <span id={descriptionId} class="sr-only">
    <span data-lang-content="es">{description.es}</span>
    <span data-lang-content="en">{description.en}</span>
  </span>
  <pre class="showcase-ascii-art__wide" aria-hidden="true">{artwork.wide}</pre>
  <pre class="showcase-ascii-art__compact" aria-hidden="true">{artwork.compact}</pre>
</figure>
